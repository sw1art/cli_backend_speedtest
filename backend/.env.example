POSTGRES_USER=benchmark
POSTGRES_PASSWORD=benchmark
POSTGRES_DB=download_benchmark

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# These URLs use the docker-compose service names (postgres / rabbitmq).
# For local development outside Docker, replace the host with `localhost`.
DATABASE_URL=postgresql+asyncpg://benchmark:benchmark@postgres:5432/download_benchmark
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=download_tasks
RABBITMQ_RETRY_QUEUE=download_tasks.retry

MAX_RETRIES=3
RETRY_DELAY_MS=2000
HTTP_TIMEOUT=30.0
DEFAULT_REQUESTS=10
MAX_REQUESTS=100

# SSRF guard: reject URLs resolving to private/loopback/link-local addresses.
# Set SSRF_ALLOW_PRIVATE=true for local development (e.g. localhost targets).
# SSRF_ALLOWED_HOSTS accepts a comma-separated list of hostnames to always allow.
SSRF_GUARD_ENABLED=true
SSRF_ALLOW_PRIVATE=false
SSRF_ALLOWED_HOSTS=
